{
    "build_systems":
    [
        {
            "name": "build",
            "shell_cmd": "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release .. && ninja",
            "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
            "working_dir": "${project_path}/build",
            "variants":
            [
                {
                    "name": "run",
                    "shell_cmd": "ninja tic80 && bin/tic80 --skip"
                },
                {
                    "name": "fresh",
                    "shell_cmd": "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release .. --fresh"
                },
                {
                    "name": "tests",
                    "shell_cmd": "cmake -S .. -B ../build-tests -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=ON -DBUILD_WITH_ALL=ON -DBUILD_TESTS=ON && cmake --build ../build-tests --parallel --target tic80-tests && ctest --test-dir ../build-tests --output-on-failure -E api-conformance && ../build-tests/bin/api-conformance ../tests/conformance/probes"
                },
                {
                    "name": "conformance",
                    "shell_cmd": "cmake -S .. -B ../build-tests -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=ON -DBUILD_WITH_ALL=ON -DBUILD_TESTS=ON && cmake --build ../build-tests --parallel --target api-conformance && ../build-tests/bin/api-conformance ../tests/conformance/probes"
                },
                {
                    "name": "configure: BUILD_PRO=ON",
                    "shell_cmd": "cmake -DBUILD_PRO=ON .."
                }
            ]
        }
    ],
    "folders":
    [
        {
            "path": ".",
            "folder_exclude_patterns": ["build-*", "CMakeFiles"],
            "file_exclude_patterns": ["*.sublime-workspace"]
        }
    ]
}
